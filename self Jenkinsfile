pipeline {
    agent any
    environment {
        scanner=tool 'sonarqube-scanner'
    }

    stages {
        stage('git-clone') {
            steps {
                git branch: 'amazon', url: 'https://github.com/armcool007/march2026testing.git'
            }
        }
        stage('sonarqube') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh "$scanner/bin/sonar-scanner -Dsonar.projectName=amazon-prime -Dsonar.projectKey=amazon-prime"
                }
            }
        }
        stage('quality gates') {
            steps {
                waitForQualityGate abortPipeline: false, credentialsId: 'sonarqube-cred'
            }
        }
        stage('trivy scan') {
            steps {
                sh 'trivy fs . > trivyscan.txt'
            }
        }
        stage('docker-things') {
            steps {
                withDockerRegistry(credentialsId: 'dockeracctdetail',url: 'https://index.docker.io/v1/') {
                    sh ''' docker build -t armcool004/amazon-app-con .
                    docker push armcool004/amazon-app-con'''
                }
            }
        }
        stage("trivy image scan") {
            steps {
                sh 'trivy image armcool004/amazon-app-con > trivydockerimagescan.txt'
            }
        }
        stage("apply k8s") {
            steps {
                sh 'kubectl apply -f *.yml'
            }
        }
        //stage('docker image scan with docker-scout') {
         //   steps {
           //     sh '''docker scout quickview armcool004/amazon-app-con 
           //           docker scout cves armcool004/amazon-app-con
           //           docker scout recommendations armcool004/amazon-app-con'''
          //  }
       // }
    }
    post {
    always {
        script {
            def buildStatus = currentBuild.currentResult
            def buildUser = currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause')[0]?.userId ?: 'Github User'
            
            emailext (
                subject: "Pipeline ${buildStatus}: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    <p>This is a Jenkins amazon-prime-video CICD pipeline status.</p>
                    <p>Project: ${env.JOB_NAME}</p>
                    <p>Build Number: ${env.BUILD_NUMBER}</p>
                    <p>Build Status: ${buildStatus}</p>
                    <p>Started by: ${buildUser}</p>
                    <p>Build URL: <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
                """,
                to: 'intraday009@gmail.com',
                from: 'intraday009@gmail.com',
                replyTo: 'intraday009@gmail.com',
                mimeType: 'text/html',
                attachmentsPattern: 'trivyfs.txt,trivyimage.txt'
            )
        }
    }
    }
}
